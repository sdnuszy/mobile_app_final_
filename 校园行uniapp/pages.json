			},
			{
				"pagePath": "pages/my/my",
				"iconPath": "static/tabbar/ly-my01.png",
				"selectedIconPath": "static/tabbar/ly-home.png",
				"text": "我的"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
